  "keyFeatures": [
    "Digital wallet with multi-currency support",
    "Send and receive money between users",
    "Deposits via bank, Stripe, PayPal, and CoinPayments",
    "Withdrawals with configurable payout settings",
    "Currency exchange with fee management",
    "Merchant payment processing and QR codes",
    "Invoice creation and payment",
    "Request money with dispute resolution",
    "KYC document verification (identity and address proofs)",
    "Two-factor authentication (SMS OTP and Google Authenticator)",
    "Cashier shift management",
    "Role-based permissions for admin, users, merchants, and cashiers",
    "Activity logs and revenue reporting",
    "REST API with Laravel Passport authentication",
    "Real-time notifications via Firebase FCM and Pusher",
    "Modular architecture with Laravel Modules"
  ],
